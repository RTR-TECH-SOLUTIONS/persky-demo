---
interface Props {
  rating: number;
  size?: number;
  class?: string;
}
const { rating, size = 14, class: cls = '' } = Astro.props;
const full = Math.round(rating);
---

<span class={`inline-flex text-star ${cls}`} role="img" aria-label={`${rating.toLocaleString('ro-RO')} din 5 stele`}>
  {
    [1, 2, 3, 4, 5].map((i) => (
      <svg width={size} height={size} viewBox="0 0 24 24" fill={i <= full ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1Z" />
      </svg>
    ))
  }
</span>
