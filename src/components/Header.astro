---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import SearchBox from './SearchBox.tsx';
import CartDrawer from './CartDrawer.tsx';
import { CATEGORIES, PRODUCTS, SHOP, TECHNIQUES } from '../data/catalog';

const featured: Record<string, (typeof PRODUCTS)[number] | undefined> = Object.fromEntries(
  CATEGORIES.map((c) => [c.slug, [...PRODUCTS].filter((p) => p.cat === c.slug).sort((a, b) => b.sold - a.sold)[0]]),
);
const nav = [
  { label: 'Lista producătorilor', href: '/produse#producatori' },
  { label: 'Lansete pentru test', href: '/produse?test=1' },
  { label: 'Lichidări', href: '/produse?sort=reduceri', tag: 'bg-[#f0913a]' },
  { label: 'Promoții', href: '/produse?promo=1', tag: 'bg-[#ef5a4c]' },
  { label: 'Noutăți', href: '/produse?nou=1', tag: 'bg-[#5fbf73]' },
  { label: 'Blog', href: '/#ghiduri' },
];
---

<header class="relative z-40">
  <div class="bg-accent text-white">
    <div class="wrap flex h-8 items-center justify-center gap-6 text-[0.8rem] font-medium md:justify-between">
      <p>Transport gratuit la comenzi peste {SHOP.freeShipping} lei</p>
      <p class="hidden md:block">
        Comenzi telefonice: <a href={SHOP.phoneHref} class="font-semibold underline-offset-2 hover:underline">{SHOP.phone}</a>{' '}
        <span class="text-white/70">({SHOP.hours})</span>
      </p>
    </div>
  </div>

  <div class="bg-white">
    <div class="wrap flex items-center gap-4 py-4 lg:gap-8 lg:py-5">
      <button type="button" class="-ml-2 grid size-11 place-items-center rounded-lg text-ink hover:bg-page lg:hidden" data-drawer-open aria-label="Deschide meniul">
        <Icon name="menu" size={24} />
      </button>
      <Logo />
      <div class="hidden flex-1 md:block lg:max-w-[620px]">
        <SearchBox client:idle />
      </div>
      <div class="ml-auto flex items-center gap-1 sm:gap-3">
        <a href="#" class="hidden flex-col items-center gap-0.5 rounded-md px-2.5 py-1 text-ink hover:text-accent sm:flex" aria-label="Contul meu">
          <Icon name="user" size={24} stroke={1.6} />
          <span class="text-xs font-medium">Contul meu</span>
        </a>
        <a href="#" class="flex flex-col items-center gap-0.5 rounded-md px-2.5 py-1 text-ink hover:text-accent" aria-label="Favorite">
          <span class="relative">
            <Icon name="heart" size={24} stroke={1.6} />
            <span data-fav-count class="absolute -right-2.5 -top-1.5 hidden min-w-[18px] place-items-center rounded-full bg-sale px-1 text-[0.68rem] font-bold leading-[18px] text-white"></span>
          </span>
          <span class="hidden text-xs font-medium sm:block">Favorite</span>
        </a>
        <CartDrawer client:load />
      </div>
    </div>
    <div class="wrap pb-3 md:hidden">
      <SearchBox client:idle />
    </div>
  </div>

  <nav class="relative hidden bg-bar text-white lg:block" aria-label="Principal">
    <div class="wrap flex h-[52px] items-stretch">
      <button
        type="button"
        data-mega-toggle
        aria-expanded="false"
        aria-controls="mega"
        class="flex w-[260px] shrink-0 items-center gap-3 bg-white px-5 font-display text-lg font-bold text-ink"
      >
        <Icon name="menu" size={22} />
        Produse
        <Icon name="down" size={18} class="ml-auto transition-transform" />
      </button>
      <ul class="flex flex-1 items-center justify-around gap-2 pl-6 text-[0.92rem]">
        {
          nav.map((n) => (
            <li>
              <a href={n.href} class:list={['flex items-center gap-2 rounded px-1 py-1 hover:text-white hover:underline underline-offset-4', n.tag ? 'font-semibold text-white' : 'text-white/85']}>
                {n.tag && <span class={`size-2 rounded-full ${n.tag}`} aria-hidden="true" />}
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div id="mega" hidden class="absolute inset-x-0 top-full">
      <div class="wrap">
        <div class="flex overflow-hidden rounded-b-lg bg-white text-ink shadow-2xl">
          <ul class="w-[260px] shrink-0 border-r border-line py-2" role="list">
            {
              CATEGORIES.map((c, i) => (
                <li>
                  <a
                    href={`/produse?cat=${c.slug}`}
                    data-mega-cat={c.slug}
                    class:list={['flex items-center justify-between px-5 py-2.5 text-[0.95rem] font-medium', i === 0 && 'is-active']}
                  >
                    {c.name}
                    <Icon name="right" size={16} class="text-muted" />
                  </a>
                </li>
              ))
            }
          </ul>
          {
            CATEGORIES.map((c, i) => {
              const f = featured[c.slug];
              return (
                <div data-mega-panel={c.slug} hidden={i !== 0} class="flex flex-1 gap-8 p-7">
                  <div class="flex-1">
                    <p class="font-display text-xl font-bold">{c.name}</p>
                    <ul class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1.5 text-[0.95rem]">
                      {c.subs.map((s) => (
                        <li>
                          <a href={`/produse?sub=${s.slug}`} class="text-ink-2 hover:text-accent hover:underline">
                            {s.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                    <a href={`/produse?cat=${c.slug}`} class="mt-5 inline-block text-sm font-semibold text-accent hover:underline">
                      Toate produsele din {c.name.toLowerCase()}
                    </a>
                  </div>
                  <div class="w-48 shrink-0">
                    <p class="text-sm font-semibold text-muted">După tehnică</p>
                    <ul class="mt-3 space-y-1.5 text-[0.95rem]">
                      {TECHNIQUES.map((t) => (
                        <li>
                          <a href={`/produse?cat=${c.slug}&tehnica=${t.slug}`} class="text-ink-2 hover:text-accent hover:underline">
                            {t.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                  {f && (
                    <a href={`/produs/${f.slug}`} class="group w-52 shrink-0 rounded-lg border border-line p-3">
                      <img src={`/img/${f.img}.webp`} alt="" width="200" height="200" loading="lazy" class="aspect-square w-full rounded bg-photo object-contain" />
                      <p class="mt-2 text-xs font-semibold text-accent">Cel mai vândut</p>
                      <p class="line-clamp-2 text-sm font-medium group-hover:underline">{f.name}</p>
                      <p class="price mt-1">{f.price} lei</p>
                    </a>
                  )}
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </nav>

  <!-- mobile drawer -->
  <div data-drawer hidden class="fixed inset-0 z-[80] lg:hidden">
    <button type="button" data-drawer-close class="absolute inset-0 bg-black/40" aria-label="Închide meniul"></button>
    <div class="absolute inset-y-0 left-0 flex w-[88%] max-w-[360px] flex-col overflow-y-auto bg-white" role="dialog" aria-modal="true" aria-label="Meniu">
      <div class="flex items-center justify-between border-b border-line px-4 py-3">
        <span class="font-display text-xl font-bold text-ink">Produse</span>
        <button type="button" data-drawer-close class="grid size-11 place-items-center rounded-lg hover:bg-page" aria-label="Închide">
          <Icon name="x" />
        </button>
      </div>
      <ul class="divide-y divide-line">
        {
          CATEGORIES.map((c) => (
            <li>
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3.5 font-medium text-ink">
                  {c.name}
                  <Icon name="down" size={18} class="text-muted transition-transform group-open:rotate-180" />
                </summary>
                <ul class="bg-page pb-2">
                  {c.subs.map((s) => (
                    <li>
                      <a href={`/produse?sub=${s.slug}`} class="block px-6 py-2 text-[0.95rem]">
                        {s.name}
                      </a>
                    </li>
                  ))}
                  <li>
                    <a href={`/produse?cat=${c.slug}`} class="block px-6 py-2 text-[0.95rem] font-semibold text-accent">
                      Toate
                    </a>
                  </li>
                </ul>
              </details>
            </li>
          ))
        }
      </ul>
      <ul class="mt-2 border-t-8 border-page py-2">
        {
          nav.map((n) => (
            <li>
              <a href={n.href} class="block px-4 py-2.5 font-medium text-ink">
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-auto bg-bar px-4 py-4 text-sm text-white">
        <p class="text-white/70">Comenzi telefonice</p>
        <a href={SHOP.phoneHref} class="font-display text-xl font-bold">{SHOP.phone}</a>
      </div>
    </div>
  </div>
</header>

<style>
  [data-mega-cat].is-active,
  [data-mega-cat]:hover {
    background: var(--color-page);
    color: var(--color-accent);
  }
  [data-mega-toggle][aria-expanded='true'] svg:last-child {
    transform: rotate(180deg);
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-mega-toggle]');
  const mega = document.getElementById('mega');
  if (toggle && mega) {
    const set = (open: boolean) => {
      mega.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => set(mega.hidden));
    document.addEventListener('click', (e) => {
      if (!mega.hidden && !toggle.contains(e.target as Node) && !mega.contains(e.target as Node)) set(false);
    });
    document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
    const show = (slug: string) => {
      mega.querySelectorAll<HTMLElement>('[data-mega-panel]').forEach((p) => (p.hidden = p.dataset.megaPanel !== slug));
      mega.querySelectorAll<HTMLElement>('[data-mega-cat]').forEach((a) => a.classList.toggle('is-active', a.dataset.megaCat === slug));
    };
    mega.querySelectorAll<HTMLElement>('[data-mega-cat]').forEach((a) => {
      a.addEventListener('mouseenter', () => show(a.dataset.megaCat!));
      a.addEventListener('focus', () => show(a.dataset.megaCat!));
    });
  }

  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  if (drawer) {
    const set = (open: boolean) => {
      drawer.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    document.querySelectorAll('[data-drawer-open]').forEach((b) => b.addEventListener('click', () => set(true)));
    drawer.querySelectorAll('[data-drawer-close]').forEach((b) => b.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
  }
</script>
