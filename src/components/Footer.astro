---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { SHOP } from '../data/catalog';

const orders = ['Plata online cu cardul', 'Plata în 3-12 rate', 'Costuri de livrare și transport gratuit', 'Ridicare din magazinul din Brăila', 'Livrare în Republica Moldova'];
const useful = ['Cum aleg lanseta potrivită', 'Formular de retur', 'Formular de garanție', 'Retur în 30 de zile', 'Termeni și condiții', 'Politica de confidențialitate'];
---

<footer class="mt-16 bg-bar text-white/80">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <h2 class="font-display text-xl font-bold text-white">Despre Persky</h2>
      <p class="mt-4 text-sm leading-relaxed">
        Magazin de pescuit în Brăila din 2009, cu 600 mp de showroom la 10 minute de Dunăre. Toate produsele din site sunt și pe raft, le poți vedea și încerca înainte să le iei.
      </p>
      <a href="/#magazin" class="btn btn-accent btn-sm mt-5">Vezi magazinul</a>
    </div>
    <div>
      <h2 class="font-display text-xl font-bold text-white">Comenzi și transport</h2>
      <ul class="mt-4 space-y-2 text-sm">{orders.map((o) => <li><a href="#" class="hover:text-white hover:underline">{o}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="font-display text-xl font-bold text-white">Date utile</h2>
      <ul class="mt-4 space-y-2 text-sm">{useful.map((o) => <li><a href="#" class="hover:text-white hover:underline">{o}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="font-display text-xl font-bold text-white">Date de contact</h2>
      <ul class="mt-4 space-y-3 text-sm">
        <li class="flex gap-3"><Icon name="pin" size={18} class="mt-0.5 shrink-0 text-white/60" /><span>{SHOP.address}<br /><span class="text-white/60">Program: {SHOP.hours}</span></span></li>
        <li class="flex gap-3"><Icon name="phone" size={18} class="mt-0.5 shrink-0 text-white/60" /><span>Comenzi: <a href={SHOP.phoneHref} class="font-semibold text-white hover:underline">{SHOP.phone}</a><br />Magazin: 0239 612 408</span></li>
        <li class="flex gap-3"><Icon name="mail" size={18} class="mt-0.5 shrink-0 text-white/60" /><a href={`mailto:${SHOP.email}`} class="hover:text-white hover:underline">{SHOP.email}</a></li>
      </ul>
      <div class="mt-5 flex gap-2">
        {
          [
            ['Facebook', 'M14 8h3V4h-3a4 4 0 0 0-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8Z'],
            ['Instagram', 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm5.5-1.5h.01'],
            ['YouTube', 'M22 8.5a3 3 0 0 0-2.1-2.1C18 6 12 6 12 6s-6 0-7.9.4A3 3 0 0 0 2 8.5 31 31 0 0 0 2 12a31 31 0 0 0 .1 3.5 3 3 0 0 0 2 2.1C6 18 12 18 12 18s6 0 7.9-.4a3 3 0 0 0 2.1-2.1A31 31 0 0 0 22 12a31 31 0 0 0 0-3.5ZM10 15V9l5 3Z'],
          ].map(([n, d]) => (
            <a href="#" aria-label={n} class="grid size-10 place-items-center rounded-lg bg-white/10 text-white hover:bg-white/20">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d={d} /></svg>
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="wrap flex flex-col items-center justify-between gap-4 py-5 text-xs text-white/50 sm:flex-row">
      <Logo light />
      <p>© 2009-2026 Persky. Plată securizată cu cardul, ramburs sau în rate.</p>
    </div>
  </div>
</footer>
