---
import { ICONS, type IconName } from '../lib/icons';
interface Props {
  name: IconName;
  size?: number;
  class?: string;
  stroke?: number;
}
const { name, size = 20, class: cls = '', stroke = 1.8 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  set:html={ICONS[name]}
/>
